{
  "name": "@second-seat/bot",
  "version": "0.1.0",
  "description": "Second Seat bot service stub. Model clients stay behind interfaces; fixture mode is the default.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
